# ---------- Source / docs: normalize to LF ----------
* text=auto
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.html text eol=lf
*.css text eol=lf

# ---------- Frozen data: preserve exact bytes ----------
# freeze_manifest.json 使用字节级 SHA-256；以下路径禁止 Git 换行符转换。
data/** -text
bi/data/** -text
*.csv -text

# ---------- Binary assets ----------
*.parquet binary
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
